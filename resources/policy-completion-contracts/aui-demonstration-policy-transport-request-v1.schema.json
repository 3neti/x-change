{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x-change.aui-demonstration-policy-transport-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "demonstration_only",
    "applicant_evidence_mode",
    "idempotency_key",
    "preparation_fingerprint",
    "driver",
    "coverage",
    "payment",
    "completion"
  ],
  "properties": {
    "schema": { "const": "x-change.aui-demonstration-policy-transport-request.v1" },
    "demonstration_only": { "const": true },
    "applicant_evidence_mode": { "const": "withheld" },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "preparation_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "type", "amount_minor", "currency", "effective_at", "expires_at"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "amount_minor": { "type": ["integer", "null"], "minimum": 0 },
        "currency": { "type": "string", "minLength": 3 },
        "effective_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recognition_reference", "amount_minor", "settled_at"],
      "properties": {
        "recognition_reference": { "type": "string", "minLength": 1 },
        "amount_minor": { "type": "integer", "minimum": 0 },
        "settled_at": { "type": "string", "format": "date-time" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_reference", "pay_code_reference", "claim_number"],
      "properties": {
        "projection_reference": { "type": "string", "minLength": 1 },
        "pay_code_reference": { "type": "string", "minLength": 1 },
        "claim_number": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
