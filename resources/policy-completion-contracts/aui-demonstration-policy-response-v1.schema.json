{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.3neti.com/x-change/aui-demonstration-policy-response-v1.schema.json",
    "title": "AUI Demonstration Policy Response",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "status",
        "policy_reference",
        "product_code",
        "effective_at",
        "expires_at",
        "document_ready",
        "demonstration_only"
    ],
    "properties": {
        "schema": { "const": "x-change.aui-demonstration-policy-response.v1" },
        "status": { "const": "issued_demo" },
        "policy_reference": { "type": "string", "pattern": "^AUI-DEMO-[A-F0-9]{16}$" },
        "product_code": { "const": "AUI-PA-DEMO" },
        "effective_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "document_ready": { "const": false },
        "demonstration_only": { "const": true }
    }
}
