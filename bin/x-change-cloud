#!/usr/bin/env php
<?php

declare(strict_types=1);

$artisan = getcwd().DIRECTORY_SEPARATOR.'artisan';

if (! is_file($artisan)) {
    fwrite(STDERR, "Run x-change-cloud from the root of a Laravel application.\n");

    exit(1);
}

$arguments = array_slice($argv, 1);
$command = [PHP_BINARY, $artisan, 'x-change:cloud', ...$arguments];
$process = proc_open($command, [STDIN, STDOUT, STDERR], $pipes);

if (! is_resource($process)) {
    fwrite(STDERR, "Unable to start the X-Change Cloud command.\n");

    exit(1);
}

exit(proc_close($process));

