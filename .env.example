# =============================================================================
# 3NETI/X-CHANGE ENVIRONMENT CONTRACT
# =============================================================================
#
# This file documents variables owned or consumed by 3neti/x-change.
# Copy values into the consuming Laravel application's environment; never commit
# real credentials. Provider packages contribute their own profile-specific
# variables when `php artisan x-change:configure` builds the host contract.

# -----------------------------------------------------------------------------
# Activation And Profile
# -----------------------------------------------------------------------------

# Explicit provider deployment profile.
# Required: all profiles
# Secret: no
# Values: development, netbank, paynamics, hybrid, custom
XCHANGE_DEPLOYMENT_PROFILE=development

# Runtime durability tier, independent from provider topology.
# Required: all profiles
# Secret: no
# Values: local, staging, production
XCHANGE_RUNTIME_TIER=local

# Secret used to unlock the protected commissioning checklist.
# Required: production deployments
# Secret: yes
XCHANGE_COMMISSIONING_ACCESS_TOKEN=

# Expose the authenticated System Readiness workspace.
# Keep disabled unless operators require the page before role-based access is enabled.
# Secret: no
XCHANGE_COCKPIT_SYSTEM_READINESS_VISIBLE=false

# Initial Quick Generate template: blank or repeat_last.
# Repeat Last falls back to Blank when no successful issuance is available.
# Secret: no
XCHANGE_COCKPIT_QUICK_GENERATE_STARTUP_MODE=blank

# -----------------------------------------------------------------------------
# Identity And Authorization
# -----------------------------------------------------------------------------

# Stable lookup column for the non-interactive system principal.
# Required: netbank, paynamics, hybrid, custom
# Secret: no
XCHANGE_SYSTEM_USER_COLUMN=email

# Stable identifier for the non-interactive system principal.
# Required: netbank, paynamics, hybrid, custom
# Secret: no
XCHANGE_SYSTEM_USER_ID=

# Require verified mobile ownership during production onboarding.
# Secret: no
XCHANGE_MOBILE_VERIFICATION_ENABLED=true

# Require OTP in onboarding-voucher claim experiences.
# Secret: no
XCHANGE_ONBOARDING_REQUIRE_OTP=true

# Require invited Accounts to choose a PIN before entering Cockpit.
# Secret: no
XCHANGE_ONBOARDING_REQUIRE_PIN_SETUP=true

# Identity OTP gateway. Payout authorization remains separately configured.
# Secret: no
XCHANGE_IDENTITY_OTP_DRIVER=txtcmdr

# Versioned txtcmdr OTP API endpoint.
# Secret: no
TXTCMDR_API_URL=https://txtcmdr.example.com

# Scoped txtcmdr OTP challenge API bearer token.
# Secret: yes
TXTCMDR_API_TOKEN=

# Payout authorization driver; this is not claimant identity OTP.
# Secret: no
XCHANGE_WITHDRAWAL_OTP_DRIVER=paynamics

# -----------------------------------------------------------------------------
# Instruction Services
# -----------------------------------------------------------------------------

# Optional services may be unavailable without blocking commissioning. List
# capabilities here only when this deployment promises them to issuers.
# Values: location, kyc, otp, selfie, signature, feedback.sms, feedback.email
XCHANGE_REQUIRED_INSTRUCTION_CAPABILITIES=

# Server-only Location evidence services. Never expose these through VITE_*.
OPENCAGE_API_KEY=
LOCATION_HANDLER_MAP_PROVIDER=mapbox
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# HyperVerge KYC. Fake mode is accepted only outside production.
KYC_USE_FAKE=false
HYPERVERGE_BASE_URL=https://ind.idv.hyperverge.co/v1
HYPERVERGE_APP_ID=
HYPERVERGE_APP_KEY=
HYPERVERGE_URL_WORKFLOW=onboarding

# -----------------------------------------------------------------------------
# Evidence Storage
# -----------------------------------------------------------------------------

# Live deployments must use a private durable object store. Laravel Cloud
# injects the S3-compatible credentials when a private bucket is attached.
XCHANGE_CLAIM_EVIDENCE_DISK=s3
XCHANGE_CLAIM_EVIDENCE_DIRECTORY=x-change/claim-evidence
XCHANGE_INSTANCE_KEEPSAKE_DISK=s3
XCHANGE_INSTANCE_KEEPSAKE_DIRECTORY=x-change/instance-keepsakes
XCHANGE_INSTANCE_KEEPSAKE_PUBLIC_KEY=
XCHANGE_INSTANCE_KEEPSAKE_DOWNLOAD_TTL_MINUTES=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Treasury And Accounting
# -----------------------------------------------------------------------------

# Stable legal-entity reference for Treasury positions.
# Required: netbank, paynamics, hybrid, custom
# Secret: no
XCHANGE_TREASURY_LEGAL_ENTITY_REFERENCE=

# Approved legal-vocabulary profile version.
# Required: netbank, paynamics, hybrid, custom
# Secret: no
XCHANGE_TREASURY_LEGAL_PROFILE_VERSION=2026-01
XCHANGE_COMMERCIAL_USE_PUBLISHED_OFFERINGS=false
XCHANGE_COMMERCIAL_LEGAL_ENFORCEMENT=advisory

# Refresh cached provider liquidity on the package schedule.
# Secret: no
XCHANGE_FUNDING_LIQUIDITY_SCHEDULED_REFRESH_ENABLED=true

# -----------------------------------------------------------------------------
# Delivery
# -----------------------------------------------------------------------------

# Dedicated queue for x-change feedback delivery.
# Secret: no
XCHANGE_REDEMPTION_FEEDBACK_QUEUE=x-change-feedback

# Enable explicit redemption-feedback orchestration.
# Secret: no
XCHANGE_REDEMPTION_FEEDBACK_ENABLED=true

# Shared secret for configured redemption-feedback webhooks.
# Secret: yes
XCHANGE_REDEMPTION_FEEDBACK_WEBHOOK_SECRET=

# x-feedback SMS transport driver.
# Secret: no
X_FEEDBACK_SMS_DRIVER=log

# Public sender label assigned by the SMS transport.
# Secret: no
X_FEEDBACK_SMS_SENDER=XCHANGE

# Permit explicit campaign SMS actions.
# Secret: no
XCHANGE_CAMPAIGNS_SMS_DELIVERY_ENABLED=false

# Permit explicit campaign email actions.
# Secret: no
XCHANGE_CAMPAIGNS_EMAIL_DELIVERY_ENABLED=false

# Laravel mail transport.
# Secret: no
MAIL_MAILER=log

# Verified public sender identity.
# Secret: no
MAIL_FROM_ADDRESS=settlement@example.test
MAIL_FROM_NAME="x-Change"

# SMTP settings used only when MAIL_MAILER=smtp.
# Secret: mixed; username and password must remain blank in source control
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# API-provider credentials used only by their selected Laravel mailer.
# Secret: yes unless noted otherwise
RESEND_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# EngageSpark settings used only when its SMS transport is selected.
# Secret: API key and organization ID
ENGAGESPARK_API_KEY=
ENGAGESPARK_ORGANIZATION_ID=
ENGAGESPARK_SENDER_ID=XCHANGE

# -----------------------------------------------------------------------------
# Queues And Scheduling
# -----------------------------------------------------------------------------

# Durable queue connection for asynchronous financial workflows.
# Secret: no
QUEUE_CONNECTION=database

# Shared cache used by locks, idempotency, and the scheduler.
# Secret: no
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Broadcasting
# -----------------------------------------------------------------------------

# Laravel broadcast connection.
# Secret: no
BROADCAST_CONNECTION=log

# Broadcast confirmed funding projection changes to authenticated clients.
# Secret: no
XCHANGE_FUNDING_BROADCAST_ENABLED=false
