{
    "name": "3neti/x-change",
    "description": "X-Change API-first financial product platform for onboarding, wallet, pricing, Pay Code issuance, and redemption workflows.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lester B. Hurtado"
        }
    ],
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/3neti/onboarding.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-action.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-campaign.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-commerce.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-feedback.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-journal.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-ray.git"
        },
        {
            "type": "git",
            "url": "https://github.com/3neti/x-rider.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "3neti/cash": "^1.3",
        "3neti/contact": "^1.1",
        "3neti/emi-core": "^2.0@beta",
        "3neti/emi-netbank": "^2.1",
        "3neti/emi-paynamics": "^2.0@beta",
        "3neti/form-flow": "^1.8",
        "3neti/form-handler-kyc": "^1.1",
        "3neti/form-handler-location": "^1.2",
        "3neti/form-handler-otp": "^1.2",
        "3neti/form-handler-selfie": "^1.1",
        "3neti/form-handler-signature": "^1.2",
        "3neti/instruction": "^0.2",
        "3neti/laravel-model-channel": "^1.1",
        "3neti/merchant": "^1.2",
        "3neti/money-issuer": "^1.1",
        "3neti/onboarding": "^1.0",
        "3neti/report-registry": "^1.1",
        "3neti/voucher": "^1.0@beta",
        "3neti/wallet": "^2.0@beta",
        "3neti/x-action": "^1.0",
        "3neti/x-campaign": "^1.0",
        "3neti/x-commerce": "^1.0",
        "3neti/x-feedback": "^1.0",
        "3neti/x-journal": "^1.0",
        "3neti/x-ray": "^1.0",
        "3neti/x-rider": "^1.0",
        "brick/money": "^0.10.3",
        "endroid/qr-code": "^6.1",
        "illuminate/contracts": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-data": "^4.21",
        "symfony/yaml": "^7.4"
    },
    "suggest": {
        "3neti/x-legal": "Provides jurisdiction-aware advisory Treasury vocabulary and policy traceability."
    },
    "require-dev": {
        "dedoc/scramble": "^0.13.20",
        "inertiajs/inertia-laravel": "^3.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\XChange\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\XChange\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/x-change-cloud"
    ],
    "extra": {
        "x-change": {
            "cloud-recipe": "resources/deployment/laravel-cloud.yaml",
            "deployment-guide": "docs/deployment/X_CHANGE_CLOUD_RECIPE.md",
            "adopt-command": "x-change:adopt"
        },
        "laravel": {
            "providers": [
                "LBHurtado\\XChange\\Providers\\XChangeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "php -d memory_limit=2G vendor/bin/pest",
        "test:unit": "php -d memory_limit=2G vendor/bin/pest",
        "test:coverage": "php -d memory_limit=2G vendor/bin/pest --coverage"
    }
}
